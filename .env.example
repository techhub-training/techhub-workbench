# Copy this file to .env (cp .env.example .env) and paste your key. .gitignore keeps .env out of Git.
# Get a TechHub API sandbox key: curl -X POST -H "Content-Length: 0" https://techhub.byuaccounting.net/api/v1/keys
TECHHUB_API_KEY=thk_your_key_here
# Anthropic (Claude) API key, for challenge 416 and anything that calls Claude from a script: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here
